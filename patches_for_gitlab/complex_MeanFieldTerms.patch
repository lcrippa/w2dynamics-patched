+    def rotate_to_bandbasis(self, mat):
+        """
+        Rotate a (a,2,a,2) matrix to the band basis using self.RotMat
+        of shape (a,2,a,2).
+        """
+        norb = mat.shape[0]
+        nspin = mat.shape[1]
+        
+        mat2 = mat.reshape(norb*nspin, norb*nspin)
+        rotmat = self.RotMat.reshape(norb*nspin, norb*nspin)
+        
+        mat2_t = np.linalg.inv(rotmat) @ mat2 @ rotmat
+        
+        return mat2_t.reshape(mat.shape)
+        
+    def rotate_to_orbbasis(self, mat):
