+            
+            
+def read_mean_field_file(mean_field_file):
+    r""" Reads a full four-index matrix from a text file.
+
+    Expects a text file with a header of the form:
+        <no of orbitals> BANDS
+
+    Lines look like:
+        1   u   1   u    2.50
+        1   d   1   d    1.25
+    or for complex:
+        1   u   1   u    2.50 0.10
+        1   d   1   d    1.25 -0.30
+
+    Returns the mean_field matrix as a numpy array.
+    """
+
+    if not hasattr(mean_field_file, "readline"):
+        mean_field_file = open(mean_field_file, "r")
+
+    import re
+    import numpy as np
+
+    # --- read header ---
+    header_re = re.compile(r"\s*(?:([\d]+)\s+bands?\s*)?(?:[\#%!].*)?$", re.I | re.X)
+    norbitals = None
+
+    while norbitals is None:
+        header = mean_field_file.readline()
+        match = header_re.match(header)
+        if not match:
+            raise ValueError("expecting mean_field matrix header `n BANDS`:\n%s" % header)
+        norbitals = match.group(1)
+
+    norbitals = int(norbitals)
+
+    # --- regex: (orb spin)(orb spin) value [imag] ---
+    line_re = (
+        r"\s*(?:"
+        r"(\d+)\s*([ud])\s+"
+        r"(\d+)\s*([ud])\s+"
+        r"([^\s#%!]+)"          # real
+        r"(?:\s+([^\s#%!]+))?"  # optional imag
+        r"\s*)?(?:[#%!].*)?$"
+    )
+    line_re = re.compile(line_re, re.I | re.X)
+
+    entries = []
+    values = []
+
+    mean_field_file.flush()
+
+    for line in mean_field_file:
+        match = line_re.match(line)
+        if not match:
+            raise ValueError("invalid mean_field matrix entry:\n%s" % line)
+
+        groups = match.groups()
+
+        if groups[0] is None:
+            # empty/comment line
+            continue
+
+        i_orb, i_sp, j_orb, j_sp, real_str, imag_str = groups
+
+        # --- converters ---
+        def get_orbital(orb):
+            orb = int(orb)
+            if orb < 1 or orb > norbitals:
+                raise ValueError("invalid orbital: %d\n%s" % (orb, line))
+            return orb - 1
+
+        def get_spin(sp):
+            return "du".index(sp)
+
+        # convert indices
+        i_orb = get_orbital(i_orb)
+        j_orb = get_orbital(j_orb)
+        i_sp = get_spin(i_sp)
+        j_sp = get_spin(j_sp)
+
+        # convert value
+        if imag_str is None:
+            value = float(real_str)
+            dtype = float
+        else:
+            value = float(real_str) + 1.0j * float(imag_str)
+            dtype = complex
+
+        entries.append((i_orb, i_sp, j_orb, j_sp))
+        values.append(value)
+
+    # --- build matrix ---
+    entries = np.array(entries, dtype=int)
+    values = np.array(values, dtype=value.__class__)
+
+    # choose correct dtype for the matrix
+    mat_dtype = complex if np.iscomplexobj(values) else float
+    mean_field_matrix = np.zeros((norbitals, 2, norbitals, 2), dtype=mat_dtype)
+
+    i, si, j, sj = entries.T
+    mean_field_matrix[i, si, j, sj] = values
+
+    return mean_field_matrix
+    
+    
+def write_mean_field_file(out, mean_field_matrix, comment=None):
+    """Writes a full four-index mean_field matrix to a text file.
+
+    Supports both real and complex values. The output format matches
+    read_mean_field_file:
+
+        <no of orbitals> BANDS
+
+    with lines like:
+
+        1   u   1   u    2.50
+        1   u   1   u    2.50 0.10
+    """
+
+    import numpy as np
+
+    if comment is not None:
+        out.write("# {}\n".format(comment))
+
+    if len(mean_field_matrix.shape) != 4:
+        raise ValueError("mean_field_matrix argument has wrong shape")
+
+    norbitals = mean_field_matrix.shape[0]
+    out.write(f"{norbitals} BANDS\n")
+
+    # find nonzero entries
+    nonzero_indices = np.transpose(np.nonzero(mean_field_matrix))
+
+    for iorb, isp, jorb, jsp in nonzero_indices:
+        value = mean_field_matrix[iorb, isp, jorb, jsp]
+
+        # convert to 1-based and spin letters without mutating indices
+        iorb1 = iorb + 1
+        jorb1 = jorb + 1
+        isp_c = 'd' if isp == 0 else 'u'
+        jsp_c = 'd' if jsp == 0 else 'u'
+
+        if np.iscomplexobj(value):
+            # write: real imag
+            out.write(
+                f"{iorb1} {isp_c}  {jorb1} {jsp_c}  "
+                f"{value.real:.18e} {value.imag:.18e}\n"
+            )
+        else:
+            # write: real only
+            out.write(
+                f"{iorb1} {isp_c}  {jorb1} {jsp_c}  "
+                f"{float(value):.18e}\n"
+            )
+
 
 
