+import sys
+sys.path.insert(0,"../../")
+import numpy as np
+import w2dyn.dmft.orbspin as orbspin
+import w2dyn.dmft.atoms as atoms
+import dc_wterm as doublecounting
+import mf_phonons as phonons
+import w2dyn.auxiliaries.input as inpt
+
+
+u2 = 0.5
+w = [44.03,44.03,50.20,50.20]
+v = 48.33
+jj = 16.38
+shifts = [-202.825, 0]
+ll = 1.0
+a22 = 2.0
+a11 = 3.0
+beta = 4.0
+
+densities = np.random.rand(12, 2, 12, 2)
+
+with open("A.dat", "r") as Afile:
+    A = inpt.read_u_matrix(Afile,spin=True)
+with open("B.dat", "r") as Bfile:
+    B = inpt.read_mean_field_file(Bfile)
+
+dc_from_mf_terms = np.einsum('ijklabcd,abcd->ijkl', A, densities) + B
