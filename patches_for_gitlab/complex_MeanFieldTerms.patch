+    for iterm in range(len(dc_coeff_array)):
+        if dc_dens_array[iterm][0]=="NODENS":
+            iindex = orbvalley_index(dc_op_array[iterm][0],dc_op_array[iterm][1],dc_op_array[iterm][3])
