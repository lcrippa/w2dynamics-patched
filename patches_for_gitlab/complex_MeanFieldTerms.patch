+dc_wterm = doublecounting.Wterm(u2,w,v,jj,ll,a22,a11,beta,shifts,True,False)
+dc_from_wterm = dc_wterm.get(densities=densities)
+
+print(np.allclose(dc_from_mf_terms,dc_from_wterm))
