+        
+        mat2 = mat.reshape(norb*nspin, norb*nspin)
+        rotmat = self.RotMat.reshape(norb*nspin, norb*nspin)
+        
+        mat2_t = rotmat @ mat2 @ np.linalg.inv(rotmat)
+        
+        return mat2_t.reshape(mat.shape)
