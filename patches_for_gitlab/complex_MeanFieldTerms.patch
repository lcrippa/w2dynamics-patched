+
+        
+def orbvalley_index_j(orbindex,valleyindex,elec_type):
+    if elec_type=="f":
+        orbvalley= 2 * valleyindex + orbindex
+    if elec_type=="c":
+        orbvalley= 4 + 4 * valleyindex + orbindex + 2
+    return orbvalley
+    
+def orbvalley_index(orbindex,valleyindex,elec_type):
+    if elec_type=="f":
+        Norb=2
+    if elec_type=="c":
+        Norb=4
+    orbvalley = 4*(elec_type=="c") + Norb * valleyindex + orbindex
+    return orbvalley
+
+
+#################
+# Hartree shift #
+#################
+        
+
+# First 4 orbitals
+for ispin in range(2):
+    for iorb in range(0,4):
+        B[iorb, ispin, iorb, ispin] += shifts[0]
+
+# Orbitals 4..11
+for ispin in range(2):
+    for iorb in range(4,12):
+        B[iorb, ispin, iorb, ispin] += shifts[1]
+        
+#################        
+# U2 terms #
+#################
+
+if abs(u2) > 1e-10:
+    print("DC: U2 term")
+    for ispin in range(2):
+        for iorb_f in range(4):
+            # linear part: densities
+            for a in range(4):
+                for s in range(2):
+                    A[iorb_f, ispin, iorb_f, ispin, a, s, a, s] += 6.0 * u2
+            # constant part: -0.5 per term
+            B[iorb_f, ispin, iorb_f, ispin] += 6.0 * u2 * (-0.5 * 4 * 2)  # 4 orbitals × 2 spins = 8
+            
+#################        
+# W and V terms #
+#################
+
+print("DC: W Hartree term")
+
+#First term
+for ispin in range(2):
+    for ival_c in range(2):
+        for iorb_c in range(4):
