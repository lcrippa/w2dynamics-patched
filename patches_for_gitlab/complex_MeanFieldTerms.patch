+# f+c terms, x and y
+for phononterm in [[ph.VfX,ph.VcX],[ph.VfY,ph.VcY]]:
+    firstop=phonons.onebody_op("f",phononterm[0])
+    firstop.create_1bo()
+    secondop=phonons.onebody_op("c",phononterm[1])
