+            # linear contribution
+            for a in range(4):
+                for s in range(2):
+                    A[index_c, ispin, index_c, ispin, a, s, a, s] += w[iorb_c]
+            # constant contribution
+            B[index_c, ispin, index_c, ispin] += w[iorb_c] * (-0.5 * 4 * 2)  # 4 orbitals × 2 spins
+            
+#Second term
+for ispin in range(2):
+    for iorb_f in range(4):
+        for ival_c in range(2):
+            for iorb_c in range(4):
+                index_c = orbvalley_index(iorb_c, ival_c, "c")
+                # linear contribution
+                for s in range(2):
+                    A[iorb_f, ispin, iorb_f, ispin, index_c, s, index_c, s] += w[iorb_c]
+                # constant contribution
+                B[iorb_f, ispin, iorb_f, ispin] += w[iorb_c] * (-0.5 * 2)
+                
+print("DC: W Fock term")
+for ispin in range(2):
+    for jspin in range(2):
+        for iorb_f in range(4):
+            for ival_c in range(2):
+                for iorb_c in range(4):
+                    index_c = orbvalley_index(iorb_c, ival_c, "c")
+                    A[iorb_f, ispin, index_c, jspin, index_c, jspin, iorb_f, ispin] += -w[iorb_c]
+                    A[index_c, jspin, iorb_f, ispin, index_c, jspin, iorb_f, ispin] += -w[iorb_c]
+                    
+print("DC: V Hartree term")
+for ispin in range(2):
+    for iorb_c in range(4, 12):
+        # linear contribution
+        for a in range(4, 12):
+            for s in range(2):
+                A[iorb_c, ispin, iorb_c, ispin, a, s, a, s] += v
+        # constant contribution
+        B[iorb_c, ispin, iorb_c, ispin] += v * (-0.5 * 8 * 2)
+        
+#################        
+# J terms       #
+#################
+
+print("DC: J Hartree term")
+
+#First term
+for iorb in range(2):
+    for jorb in range(2):
+        for ival in range(2):
+            for jval in range(2):
+                for ispin in range(2):
+                    for jspin in range(2):
+                        ival_sign = (-1)**ival
+                        jval_sign = (-1)**jval
+                        prefactor = ival_sign * jval_sign + (-1)**(iorb+jorb)
+                        i_f = orbvalley_index_j(iorb, ival, "f")
+                        j_f = orbvalley_index_j(jorb, jval, "f")
+                        i_c = orbvalley_index_j(iorb, ival, "c")
+                        j_c = orbvalley_index_j(jorb, jval, "c")
+                        
+                        # linear
+                        A[i_f, ispin, j_f, jspin, j_c, jspin, i_c, ispin] += 0.5 * jj * prefactor
+                        
+                        # constant
+                        if (ispin == jspin) and (i_c == j_c):
+                            B[i_f, ispin, j_f, jspin] += -0.25 * jj * prefactor
+                            
+#Second term
+for iorb in range(2):
+    for jorb in range(2):
+        for ival in range(2):
+            for jval in range(2):
+                for ispin in range(2):
+                    for jspin in range(2):
+                        ival_sign = (-1)**ival
+                        jval_sign = (-1)**jval
+                        prefactor = ival_sign * jval_sign + (-1)**(iorb+jorb)
+                        i_f = orbvalley_index_j(iorb, ival, "f")
+                        j_f = orbvalley_index_j(jorb, jval, "f")
+                        i_c = orbvalley_index_j(iorb, ival, "c")
+                        j_c = orbvalley_index_j(jorb, jval, "c")
+                        
+                        # linear
+                        A[i_c, ispin, j_c, jspin, j_f, jspin, i_f, ispin] += 0.5 * jj * prefactor
+                        
+                        # constant
+                        if (ispin == jspin) and (i_f == j_f):
+                            B[i_c, ispin, j_c, jspin] += -0.25 * jj * prefactor
+
+                            
+print("DC: J Fock term")
+for iorb in range(2):
+    for jorb in range(2):
+        for ival in range(2):
+            for jval in range(2):
+                for ispin in range(2):
+                    for jspin in range(2):
+                        sign_ival = (-1)**ival
+                        sign_jval = (-1)**jval
+                        deltaval = sign_ival * sign_jval + (-1)**(iorb + jorb)
+                        i_f = orbvalley_index_j(iorb, ival, "f")
+                        i_c = orbvalley_index_j(iorb, ival, "c")
+                        j_f = orbvalley_index_j(jorb, jval, "f")
+                        j_c = orbvalley_index_j(jorb, jval, "c")
+                        
+                        A[i_f, ispin, i_c, ispin, j_c, jspin, j_f, jspin] += 0.5 * jj * deltaval
+                        A[i_c, ispin, i_f, ispin, j_c, jspin, j_f, jspin] += 0.5 * jj * deltaval
+                        
+                        
+
+print("DC: phonon terms")
+ph = phonons.phonon_1bo_params(a11, beta)
+
+def add_phonon_terms(matlist,type1,type2,coeff):
+    for phononterm in matlist:
+        firstop = phonons.onebody_op(type1, phononterm[0])
+        firstop.create_1bo()
+        secondop = phonons.onebody_op(type2, phononterm[1])
+        secondop.create_1bo()
+        twobodyterm = phonons.twobody_op(firstop, secondop, coeff)
+        twobodyterm.create_2bo()
+        twobodyterm.normalorder()
+        twobodyterm.decouple()
+        dc_coeff_array, dc_op_array, dc_dens_array = twobodyterm.print_to_dc_decoupled()
+
+        for iterm in range(len(dc_coeff_array)):
+            iindex = orbvalley_index(dc_op_array[iterm][0], dc_op_array[iterm][1], dc_op_array[iterm][3])
+            ispin  = dc_op_array[iterm][2]
+            jindex = orbvalley_index(dc_op_array[iterm][4], dc_op_array[iterm][5], dc_op_array[iterm][7])
+            jspin  = dc_op_array[iterm][6]
+
+            if dc_dens_array[iterm][0] == "NODENS":
+                B[iindex, ispin, jindex, jspin] += dc_coeff_array[iterm]
+            elif (type1!="f" or type2!="f"):
+                dens_i = orbvalley_index(dc_dens_array[iterm][0], dc_dens_array[iterm][1], dc_dens_array[iterm][3])
+                dens_s1 = dc_dens_array[iterm][2]
+                dens_j = orbvalley_index(dc_dens_array[iterm][4], dc_dens_array[iterm][5], dc_dens_array[iterm][7])
+                dens_s2 = dc_dens_array[iterm][6]
+
+                A[iindex, ispin, jindex, jspin, dens_i, dens_s1, dens_j, dens_s2] += dc_coeff_array[iterm]
+
+
+# f+f terms
+add_phonon_terms([[ph.VfX,ph.VfX],[ph.VfY,ph.VfY]],"f","f",-1*ll*a22**2)
+
+# f+c terms
+add_phonon_terms([[ph.VfX,ph.VcX],[ph.VfY,ph.VcY]],"f","c",-1*ll*a22)
+
+# c+c terms
+add_phonon_terms([[ph.VcX,ph.VcX],[ph.VcY, ph.VcY]],"c","c",-1*ll)
+
+
+A = np.array(A)
+B = np.array(B)
+
+with open("A.dat", "w") as Afile:
+    inpt.write_u_matrix(Afile,A)
+with open("B.dat", "w") as Bfile:
+    inpt.write_mean_field_file(Bfile,B)
+
